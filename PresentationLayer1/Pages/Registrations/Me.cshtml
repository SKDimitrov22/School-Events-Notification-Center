@page
@model PresentationLayer1.Pages.Registrations.MeModel
@{
    ViewData["Title"] = "My signups";
}

<section class="page-heading">
  <div>
    <h1>My signups</h1>
    <p class="muted">Your current registrations and waitlist positions.</p>
  </div>
</section>

@if (Model.Registrations.Count == 0)
{
  <section class="panel empty-state">
    <span class="badge">No signups</span>
    <h2>You haven't registered yet</h2>
    <p class="muted">Browse the events list and register to see your signups here.</p>
    <div class="actions">
      <a class="button" asp-page="/Events/Index">Browse events</a>
    </div>
  </section>
}
else
{
<section class="panel">
  <table>
    <thead>
      <tr>
        <th>Event</th>
        <th>Status</th>
        <th>Waitlist</th>
        <th>Registered</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    @foreach (var registration in Model.Registrations)
    {
      <tr>
        <td>@registration.EventTitle</td>
        <td><span class="badge @registration.Status.ToLowerInvariant()">@registration.Status</span></td>
        <td>@(registration.WaitlistPosition?.ToString() ?? "-")</td>
        <td><time class="local-time" datetime="@registration.RegisteredAt">@registration.RegisteredAt</time></td>
        <td>
          <form method="post" asp-page-handler="Cancel">
            <input type="hidden" name="registrationId" value="@registration.Id" />
            <button class="danger" type="submit">Cancel</button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
</section>
}

