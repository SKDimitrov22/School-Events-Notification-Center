@page "{id}"
@model PresentationLayer1.Pages.Organizer.Events.PreviewModel
@{
    ViewData["Title"] = "Preview";
}

@if (Model.Event is not null)
{
  <section class="panel">
    <p class="muted">Student preview</p>
    <h1>@Model.Event.Title</h1>
    <p>@Model.Event.Description</p>
    <dl class="meta">
      <div><dt>Starts</dt><dd><time class="local-time" datetime="@Model.Event.StartsAt">@Model.Event.StartsAt</time></dd></div>
      <div><dt>Ends</dt><dd><time class="local-time" datetime="@Model.Event.EndsAt">@Model.Event.EndsAt</time></dd></div>
      <div><dt>Location</dt><dd>@(Model.Event.Location ?? "TBA")</dd></div>
      <div><dt>Capacity</dt><dd>@Model.Event.Capacity</dd></div>
    </dl>
    <a class="button secondary" asp-page="/Organizer/Events/Index">Back</a>
  </section>
}
else
{
  <section class="panel empty-state">
    <span class="badge">404</span>
    <h1>Event not available</h1>
    <p class="muted">This event no longer exists or you don't have access to it.</p>
    <div class="actions">
      <a class="button secondary" asp-page="/Organizer/Events/Index">Back to events</a>
    </div>
  </section>
}

